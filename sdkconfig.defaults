#
# mbedTLS
#
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=y
CONFIG_MBEDTLS_ECJPAKE_C=y
# end of mbedTLS

#
# OpenThread
#
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_BORDER_ROUTER=n
CONFIG_OPENTHREAD_MTD=y
# Deliberately OFF. This project never resolves hostnames -- MqttConfig::broker_address is
# always a literal IPv4/IPv6 address, and NAT64 synthesis is done manually in
# openthread_link.cpp (otNetDataGetNextRoute()), not via this feature. Enabling it selects
# lwIP's custom DNS-external-resolve hook (esp_openthread_dns64.c), which intercepts EVERY
# getaddrinfo() call on the OT netif and forces a recursive IPv4-only sub-lookup -- even for
# an input that's already a literal IPv6 address. That sub-lookup's own type-mismatch check
# rejects the literal-address fast path and falls through to a real DNS query for a string
# that isn't a hostname, failing with EAI_FAIL (esp-tls: "getaddrinfo() returns 202"). Broke
# every MQTT connect (NAT64-synthesized AND plain IPv6 broker addresses alike) once a
# CMakeLists.txt-triggered reconfigure finally applied this long-dormant default -- see the
# migration plan/memory for the full diagnosis.
CONFIG_OPENTHREAD_DNS64_CLIENT=n
CONFIG_OPENTHREAD_CLI=y
CONFIG_OPENTHREAD_TASK_SIZE=4096
CONFIG_OPENTHREAD_CONSOLE_ENABLE=n
# Uplink instrumentation, both read once per publish window by openthread_link.cpp's
# read_link_stats(). The device has never set its 802.15.4 TX power, so it transmits at the
# PHY power table's maximum (+20 dBm, 305 mA peak per the C6 datasheet's Table 5-9 vs 187 mA
# at +12); whether turning that down is worth any link margin depends entirely on how much of
# each cycle is actually spent transmitting, which nothing measured before these two options.
#
# RADIO_STATS gives otRadioTimeStatsGet(): cumulative us the radio spent in TX/RX. That TX
# figure is the missing multiplier in dI_avg = dI_peak * t_tx / cycle_period.
#
# LINK_METRICS gives Thread 1.2 enhanced-ACK probing, the only way to learn the RSSI the
# PARENT measures of us. The RSSI this device already publishes is otThreadGetParentLastRssi
# -- our receiver measuring the border router's transmitter -- which cannot respond to our own
# TX power at all, so it is useless as a control input. NOTE this option selects
# IEEE802154_TIMING_OPTIMIZATION and OPENTHREAD_TIMING_OPTIMIZATION.
CONFIG_OPENTHREAD_RADIO_STATS_ENABLE=y
CONFIG_OPENTHREAD_LINK_METRICS=y
# CSL (Coordinated Sampled Listening, Thread 1.2+): builds the CSL receiver in. It only runs
# when device_config.yaml's csl_period_ms is non-zero -- see openthread_link.cpp. It adds
# scheduled receive windows on top of data polling, not instead of it. Already selects
# IEEE802154_TIMING_OPTIMIZATION/OPENTHREAD_TIMING_OPTIMIZATION, but
# CONFIG_OPENTHREAD_LINK_METRICS above already selects both.
CONFIG_OPENTHREAD_CSL_ENABLE=y
# EXPERIMENT (2026-09-19): our clock accuracy as seen by CSL, in +-ppm; default 50. Each receive
# window is widened by (this + the parent's ppm) x time since the last sync. At 50, idle CSL
# deliveries ~60 s after a sync failed 16/16 while those <0.4 s after one got 8/8 -- 255 (the
# uint8 maximum) tests whether the internal RC slow clock drifts that much across light sleep.
# Costs power: at 60 s since sync each window is ~+-17 ms instead of ~+-5 ms. Tune down, or back
# to 50, once measured.
CONFIG_OPENTHREAD_CSL_ACCURACY=255
# end of OpenThread

#
# lwIP
#
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
CONFIG_LWIP_IPV6_NUM_ADDRESSES=8
# IPV4 + ND6 on for Wi-Fi (direct IPv4 connect; ND6/RA needed for SLAAC). Thread's netif
# doesn't use either (it's IPv6-only via NAT64, and does neighbor/route discovery at its
# own MLE layer via esp_openthread_netif_glue, bypassing lwIP's ND6 state machine) but
# there's one shared sdkconfig for the whole image, so both builds link this in.
CONFIG_LWIP_IPV4=y
CONFIG_LWIP_ND6=y
# SLAAC (RFC 4862) global/ULA address generation on the Wi-Fi STA netif, for
# wifi_address_family: "ipv6". Needs CONFIG_LWIP_ND6=y above to process Router Advertisements.
CONFIG_LWIP_IPV6_AUTOCONFIG=y
# end of lwIP

#
# IEEE 802.15.4
#
CONFIG_IEEE802154_ENABLED=y
# end of IEEE 802.15.4

#
# light sleep
#
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# Lets the app hook automatic light-sleep exit (esp_pm_light_sleep_register_cbs(), see
# lp_sensor_core.c) to detect an LP-core-triggered ULP wakeup and signal SensorsTask early --
# needed once sleep entry is left entirely to the automatic PM-lock-gated path (no more manual
# esp_light_sleep_start() call to observe the wakeup cause synchronously).
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
CONFIG_PM_POWER_DOWN_PERIPHERAL_IN_LIGHT_SLEEP=y
CONFIG_IEEE802154_SLEEP_ENABLE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_SLEEP_POWER_DOWN_FLASH=y
CONFIG_ESP_MODEM_CLOCK_ENABLE_CHECKING=y
# end of light sleep

#
# Sleep Config (ESP32-C6)
#
CONFIG_ESP_PHY_MAC_BB_PD=y
# end of Sleep Config

#
# ULP / LP core (sensor read offload — see lp_sensor_core component)
#
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_LP_CORE=y
CONFIG_ULP_COPROC_RESERVE_MEM=8192
# end of ULP / LP core

#
# ESP System Settings
#
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# end of ESP System Settings

#
# Logging
# Default "RTOS" timestamps are xTaskGetTickCount()-based, and this project's own light-sleep
# wrapper (correctLightSleep(), main/common_utils.cpp) calls esp_light_sleep_start() directly
# rather than through the automatic tickless-idle path -- so the tick count is never
# compensated for time spent asleep (vTaskStepTick() is only called from esp_pm/pm_impl.c's
# own idle-hook sleep path), and RTOS-sourced log timestamps silently stop accounting for the
# ~15s+ spent in every light sleep. "SYSTEM" is gettimeofday()-backed (ultimately
# esp_timer_get_time(), confirmed RTC-backed and sleep-immune -- see the "t=%lld ms" fields
# already in correctLightSleep()'s own diagnostics), so it keeps counting through sleep. Only
# option available under this project's CONFIG_LOG_VERSION_1 that does -- LOG_VERSION_2's
# "UNIX" (a plain non-wrapping ms counter, nicer for diffing) needs a bigger, riskier logging
# subsystem upgrade not worth doing mid-investigation. Trade-off: SYSTEM prints HH:MM:SS.sss
# wall-clock-style and wraps at 24h (no RTC/NTP sync here, so it's really just elapsed time
# since boot) -- fine for the bounded captures this is being used for.
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM=y
# end of Logging

#
# Compiler
#
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# end of Compiler

#
# Flash & Partition Table
# C6FH4 has 4 MB flash; the default 1 MB single-app partition can't hold the
# std::format-using firmware (~1.33 MB). partitions.csv now carries two 1984K OTA
# slots (ota_0/ota_1 + otadata) for MQTT OTA — see main/ota_updater.cpp.
#
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
# end of Flash & Partition Table

#
# OTA rollback safety
# A freshly OTA'd image boots as PENDING_VERIFY and must call
# esp_ota_mark_app_valid_cancel_rollback() (done in sensorstask.cpp on the first
# broker-ACKed publish). If it never does, the existing REBOOT_AFTER_FAILS supervisor
# restarts the device and the bootloader falls back to the previous slot.
#
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# end of OTA rollback safety
