# Per-device configuration: sensor calibration, publish cadence, heater schedule, battery
# ADC. Same "key: \"value\"" syntax as secrets.yaml. Embedded at build time (rebuild to
# change). Unlike secrets.yaml this file holds no credentials, so it stays tracked in git.
#
# Keys marked "MQTT tunable" below double as the compiled-in fallback for a parameter Home
# Assistant can also override live, without a reflash -- see the README's "Runtime-tunable
# parameters over MQTT" section and main/runtime_config.h. Once HA has set one, that value
# lives in NVS and takes precedence over whatever is written here, until HA changes it again.

# Calibration offsets, added to the raw sensor reading before publishing.
# Derive rh_offset by comparing this sensor against a trusted reference:
#   rh_offset = reference_RH - measured_RH   (e.g. 47.8 - 67.9 = -20.1)
# Leave at "0.0" for no correction.
# MQTT tunable: <device_id>/cfg/rh_offset
rh_offset: "0.0"
# MQTT tunable: <device_id>/cfg/temp_offset
temp_offset: "0.0"

# Publish cadence. The LP core reads the sensor every lp_poll_interval_sec and publishes a
# value whose change since the last delivered one is at least temp_min_change degC or
# rh_min_change %RH; an unchanged value is skipped at most max_skip_cycles polls, so a
# publish is guaranteed at latest every (max_skip_cycles + 1) x lp_poll_interval_sec.
# Everything else is derived from this pair: the HP safeguard wake timeout is
# (max_skip_cycles + 3) x lp_poll_interval_sec and Home Assistant's expire_after is twice
# that -- nothing needs retuning when these values change.
# MQTT tunable: <device_id>/cfg/temp_min_change
temp_min_change: "0.2"
# MQTT tunable: <device_id>/cfg/rh_min_change
rh_min_change: "2.0"
# MQTT tunable: <device_id>/cfg/max_skip_cycles
max_skip_cycles: "10"
# Not MQTT tunable (would need re-arming the LP hardware timer live -- deferred).
lp_poll_interval_sec: "20"

# Heater maintenance schedule (SHT4x built-in heater), in wall-clock minutes -- converted
# to LP poll cycles at boot, so these stay correct whatever lp_poll_interval_sec is.
# heater_period_minutes: interval between periodic heater self-tests (default 24 h).
# heater_high_rh_trigger_minutes: how long RH must stay above 90 % before a creep-mitigation
# heater run fires (default 1 h). "0" disables that mechanism entirely (e.g. for power
# measurements or a sensor that must never self-heat).
# MQTT tunable: <device_id>/cfg/heater_period_minutes
heater_period_minutes: "1440"
# MQTT tunable: <device_id>/cfg/heater_high_rh_trigger_minutes
heater_high_rh_trigger_minutes: "60"

# Battery measurement. When "true", the HP core reads the battery voltage on GPIO2 (through the
# resistor divider below) right before each publish and adds it to the MQTT state message;
# readings never trigger a publish by themselves. Only the literal strings "true"/"false" are
# accepted; a missing key means "false". Boards without the divider should leave this off --
# a floating pin would publish garbage battery values.
read_battery_via_adc: "false"
# Measured divider resistor values in Ohms (battery+ -> ADC pin, and ADC pin -> battery-),
# used to scale the ADC pin voltage back to the battery voltage. Measure the actual soldered
# resistors with a multimeter for best accuracy.
battery_divider_r_vbat_ohm: "5100"
battery_divider_r_gnd_ohm: "5100"
