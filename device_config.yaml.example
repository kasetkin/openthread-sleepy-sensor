# Per-device configuration: sensor calibration, publish cadence, heater schedule, battery
# ADC. Same "key: \"value\"" syntax as secrets.yaml. Embedded at build time (rebuild to
# change). Unlike secrets.yaml this file holds no credentials, so it stays tracked in git.
#
# Keys marked "MQTT tunable" below double as the compiled-in fallback for a parameter Home
# Assistant can also override live, without a reflash -- see the README's "Runtime-tunable
# parameters over MQTT" section and main/runtime_config.h. Once HA has set one, that value
# lives in NVS and takes precedence over whatever is written here, until HA changes it again.

# Calibration offsets, added to the raw sensor reading before publishing.
# Derive rh_offset by comparing this sensor against a trusted reference:
#   rh_offset = reference_RH - measured_RH   (e.g. 47.8 - 67.9 = -20.1)
# Leave at "0.0" for no correction.
# MQTT tunable: <device_id>/cfg/rh_offset
rh_offset: "0.0"
# MQTT tunable: <device_id>/cfg/temp_offset
temp_offset: "0.0"

# Publish cadence. The LP core reads the sensor every lp_poll_interval_sec and publishes a
# value whose change since the last delivered one is at least temp_min_change degC or
# rh_min_change %RH; an unchanged value is otherwise held back until max_publish_gap_sec has
# elapsed since the last delivered publish, at which point it's forced through anyway. Everything
# else is derived from this pair: the HP safeguard wake timeout is max_publish_gap_sec plus 2 more
# polls (lp_poll_interval_sec) and Home Assistant's expire_after is twice that -- nothing needs
# retuning when these values change.
# Because the LP core only samples every lp_poll_interval_sec, max_publish_gap_sec is rounded
# DOWN to the nearest whole multiple of it internally -- so the actual gap between forced
# publishes may be up to almost one lp_poll_interval_sec SHORTER than requested, never longer.
# A value at or below lp_poll_interval_sec collapses to "publish every cycle", the finest
# cadence achievable. The MQTT/HA display always shows the raw seconds value you set, not the
# rounded internal one -- same "display what was asked for" behavior as this file's
# heater_period_minutes/heater_high_rh_trigger_minutes below (those round UP instead, since
# overshooting a heater period is the safe direction, unlike a publish-staleness bound).
# MQTT tunable: <device_id>/cfg/temp_min_change
temp_min_change: "0.2"
# MQTT tunable: <device_id>/cfg/rh_min_change
rh_min_change: "2.0"
# MQTT tunable: <device_id>/cfg/max_publish_gap_sec
max_publish_gap_sec: "300"
# Not MQTT tunable (would need re-arming the LP hardware timer live -- deferred).
lp_poll_interval_sec: "20"

# How many raw SHT4x readings the LP core averages into one reported value per poll, spaced
# 100ms apart (fixed in firmware, not itself configurable). Averaging cuts sample-to-sample
# noise by roughly 1/sqrt(N), which stops noise alone from crossing temp_min_change/
# rh_min_change above and triggering a publish nothing actually changed. Higher N means more
# LP-core active time per poll (roughly (N-1)*100ms + N*10ms) -- cheap at the default, worth
# watching at the high end of the 1..16 range if you're chasing battery life.
# MQTT tunable: <device_id>/cfg/sensor_samples
sensor_samples: "4"

# Heater maintenance schedule (SHT4x built-in heater), in wall-clock minutes -- converted
# to LP poll cycles at boot, so these stay correct whatever lp_poll_interval_sec is.
# heater_period_minutes: interval between periodic heater self-tests (default 24 h).
# heater_high_rh_trigger_minutes: how long RH must stay above 90 % before a creep-mitigation
# heater run fires (default 1 h). "0" disables that mechanism entirely (e.g. for power
# measurements or a sensor that must never self-heat).
# MQTT tunable: <device_id>/cfg/heater_period_minutes
heater_period_minutes: "1440"
# MQTT tunable: <device_id>/cfg/heater_high_rh_trigger_minutes
heater_high_rh_trigger_minutes: "60"

# TX power ceiling in dBm, applied to the 802.15.4/Wi-Fi radio. -15 to 20; 20 (table max) is
# this device's behavior before this feature existed. A value too low to sustain the uplink
# auto-reverts within a few cycles -- see the README's "Radio TX power" section.
# MQTT tunable: <device_id>/cfg/tx_power_dbm
tx_power_dbm: "20"

# Thread CSL (Coordinated Sampled Listening) receive period in ms; "0" = off. With CSL on, the
# border router sends downlink frames into a short receive window the device opens every
# period, instead of holding them until the next data poll. That bounds downlink latency but
# costs power: every period is a wake plus at least ~5 ms of radio RX, on top of the normal
# data polls (CSL does not replace them). Rough minimum extra current: 500 ms ~+700 uA,
# 1000 ms ~+350 uA, 5000 ms ~+70 uA, 10484 ms ~+33 uA. Rounded down to a multiple of 0.16 ms
# (use a multiple of 4 ms to get exactly what you ask for); 10 ms minimum, 10484 ms maximum.
# Engaged after the first confirmed publish of each boot; if the next cycles fail it switches
# itself off until the next reboot (HA "CSL status" shows "reverted"). Thread only.
# Not MQTT tunable.
csl_period_ms: "0"

# Battery measurement. When "true", the HP core reads the battery voltage on GPIO2 (through the
# resistor divider below) right before each publish and adds it to the MQTT state message;
# readings never trigger a publish by themselves. Only the literal strings "true"/"false" are
# accepted; a missing key means "false". Boards without the divider should leave this off --
# a floating pin would publish garbage battery values.
read_battery_via_adc: "false"
# Measured divider resistor values in Ohms (battery+ -> ADC pin, and ADC pin -> battery-),
# used to scale the ADC pin voltage back to the battery voltage. Measure the actual soldered
# resistors with a multimeter for best accuracy.
battery_divider_r_vbat_ohm: "5100"
battery_divider_r_gnd_ohm: "5100"
